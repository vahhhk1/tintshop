# ─────────────────────────────────────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit real secrets.
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Database (PostgreSQL). Neon/Supabase: use the pooled URL here.
# Docker (docker compose up -d) listens on 5432; `npm run db:local` (no Docker) listens on 5433.
DATABASE_URL="postgresql://tint:tint@localhost:5432/tint_shop?schema=public"
# Optional: only needed if your provider requires a shadow DB for `prisma migrate dev`.
# SHADOW_DATABASE_URL=""

# Auth.js — generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — the Google button is hidden when unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe (optional in development — a clearly-labelled demo checkout is used when unset)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Transactional email via Resend (optional — emails are logged to the console/MessageLog when unset)
EMAIL_API_KEY=""
EMAIL_FROM="Obsidian Tint Studio <bookings@yourdomain.com>"
# Where admin alerts (new booking/quote/contact/payment/review) are sent. Defaults to the business email in settings.
ADMIN_NOTIFICATION_EMAIL=""

# Image storage: "local" (dev only, writes to /public/uploads), "cloudinary" or "s3"
STORAGE_PROVIDER="local"
# Cloudinary: STORAGE_API_KEY=api key, STORAGE_SECRET=api secret, STORAGE_BUCKET=cloud name
# S3/R2/B2:   STORAGE_API_KEY=access key id, STORAGE_SECRET=secret access key, STORAGE_BUCKET=bucket name
STORAGE_API_KEY=""
STORAGE_SECRET=""
STORAGE_BUCKET=""
# S3-compatible only
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
# Public base URL for uploaded files (S3/R2 public bucket or CDN), e.g. https://cdn.yourdomain.com
STORAGE_PUBLIC_URL=""

# SMS (optional, Twilio). Leave blank to disable SMS entirely.
SMS_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token automatically)
CRON_SECRET="replace-with-a-random-string"

# Allow the simulated checkout when Stripe is not configured. Never enable in production.
ALLOW_DEMO_PAYMENTS="true"

# Public
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Google Analytics 4 measurement id, e.g. G-XXXXXXX (optional)
NEXT_PUBLIC_ANALYTICS_ID=""

# Seed: passwords for development demo accounts (seed refuses to run demo accounts in production)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin123!demo"
SEED_CUSTOMER_EMAIL="customer@example.com"
SEED_CUSTOMER_PASSWORD="Customer123!demo"
